# Copy this file to `.env` (same folder) and fill in your local values.
# Only the variable NAMES matter here — this file is the source of truth for:
#   - @ngx-env/builder (angular.json -> architect.build.options.ngxEnv), which
#     loads `.env` for `ng serve` / `ng build` and exposes these as
#     import.meta.env.NG_APP_* in the app.
#   - docker-entrypoint.sh, which regenerates ngx-env.js from the container's
#     real environment variables when the Docker image starts.
# Add a new variable here first (keep the NG_APP_ prefix), then read it via
# import.meta.env in src/environments/environment.ts.

NG_APP_API_URL=
NG_APP_KEYCLOAK_URL=
NG_APP_KEYCLOAK_REALM=
NG_APP_KEYCLOAK_CLIENT_ID=
